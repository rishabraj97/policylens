# PolicyLens Backend Environment Variables
PROJECT_NAME="PolicyLens API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Database Configuration (SQLite default for MVP, easily swapped with PostgreSQL)
DATABASE_URL="sqlite:///./policylens.db"
# Example PostgreSQL URL for future use:
# DATABASE_URL="postgresql://user:password@localhost:5432/policylens_db"

# ---- Step 3: AI Integration ----
# Your AI provider API key (NEVER commit this to version control)
AI_API_KEY="your_api_key_here"

# Model name — depends on your provider:
#   Google: "gemini-1.5-pro", "gemini-1.5-flash", "gemini-2.0-flash"
#   OpenAI: "gpt-4o", "gpt-4o-mini"
AI_MODEL="gemini-1.5-pro"

# Provider selector: "google" or "openai"
AI_PROVIDER="google"

# Number of automatic retries on transient AI failures (default: 2)
AI_MAX_RETRIES=2

# Max characters per AI chunk (default: 60000 ≈ 15k tokens)
AI_CHUNK_CHARS=60000

MAX_UPLOAD_SIZE_MB=25
